# Copy to .env (git-ignored) and fill in. Never commit .env.
# Generate the values in PowerShell (see README.md in this folder):
#   PG_PASS:  $b = New-Object byte[] 24; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString("x2") })
#   AUTHENTIK_SECRET_KEY:  $k = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($k); [Convert]::ToBase64String($k)
PG_PASS=
AUTHENTIK_SECRET_KEY=

# Optional overrides
# PG_USER=authentik
# PG_DB=authentik
# AUTHENTIK_TAG=2026.8.3
# COMPOSE_PORT_HTTP=9000
# COMPOSE_PORT_HTTPS=9443
