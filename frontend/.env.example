# Copy to .env (git-ignored). Only VITE_* values are visible to the browser, so no secrets here.
VITE_API_BASE_URL=http://localhost:5281

# prototype = hardcoded login accounts (the API must be in Auth:Mode Prototype)
# oidc      = sign in with authentik (the API must be in Auth:Mode Oidc)
VITE_AUTH_MODE=prototype

# Only used when VITE_AUTH_MODE=oidc, these are the defaults
# VITE_OIDC_AUTHORITY=http://localhost:9000/application/o/firecrest/
# VITE_OIDC_CLIENT_ID=firecrest-spa
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
